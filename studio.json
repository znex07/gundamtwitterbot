{
  "name": "Game Development Studio",
  "slug": "game-development-studio",
  "runtime": "typescript",
  "repository": {
    "owner": "znex07",
    "repo": "gundamtwitterbot",
    "branch": "game-development-studio",
    "url": "https://github.com/znex07/gundamtwitterbot/tree/game-development-studio"
  },
  "stack": {
    "client": "React 19 + TypeScript + Tailwind CSS 4",
    "engine": "three.js (WebGLRenderer + WebGPURenderer)",
    "server": "Bun server actions + Drizzle ORM (SQLite)",
    "sdk": "@hatch/space-sdk"
  },
  "modes": [
    "2d",
    "3d"
  ],
  "renderers": [
    "webgl",
    "webgpu"
  ],
  "shading": [
    "standard",
    "ghibli"
  ],
  "scenes": [
    "Voxel Dog — Tiny Voxel",
    "Tiny Dog — Super Deformed",
    "Dog Character 3D",
    "Voxel Desk — Dog at Work",
    "Ghibli Meadow",
    "Neon Orbit 3D",
    "Platformer Meadow 2D"
  ],
  "voxelArt": {
    "gallery": true,
    "aiCreator": "chat-prompt",
    "voxelRange": "60-220",
    "exportField": "generatedVoxelArt"
  },
  "sourceFiles": [
    "client/src/App.tsx",
    "client/src/api.ts",
    "client/src/theme.css",
    "client/src/assets/pig-character.jpg",
    "server/src/actions.ts",
    "server/src/schema.ts",
    "drizzle/",
    "package.json",
    "space.json"
  ]
}
